{
  "version": 2,
  "builds": [
    {
      "src": "server-v2.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**",
          "ru-auth-gateway.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server-v2.js"
    }
  ]
}
